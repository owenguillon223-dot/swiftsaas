# AI providers (multi-provider abstraction — set the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default provider used by the demo/API when the caller doesn't specify one
DEFAULT_AI_PROVIDER=claude

# Stripe
STRIPE_SECRET_KEY=
# Meter created in the Stripe dashboard (Billing > Meters). Each completed
# agent run reports one usage event against this meter's event_name.
STRIPE_METER_EVENT_NAME=agent_run
# Stripe customer ID billed for agent runs (demo default; in production this
# comes from your auth/session, not an env var).
STRIPE_DEFAULT_CUSTOMER_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
