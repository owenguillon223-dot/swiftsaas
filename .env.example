# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/swiftsaas"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genere-avec-openssl-rand-base64-32"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_ID_MENSUEL="price_..."
STRIPE_PRICE_ID_ANNUEL="price_..."
# Mêmes IDs que ci-dessus, exposés au client (page /dashboard/billing) —
# NEXT_PUBLIC_* est inliné au build, donc dupliqué exprès plutôt que partagé.
NEXT_PUBLIC_STRIPE_PRICE_MENSUEL="price_..."
NEXT_PUBLIC_STRIPE_PRICE_ANNUEL="price_..."
# Meter créé dans Stripe Dashboard > Billing > Meters, utilisé par le module
# Agent IA pour facturer chaque run à l'usage (en plus des abonnements ci-dessus).
STRIPE_METER_EVENT_NAME="agent_run"
# Price "metered" lié au Meter ci-dessus (Billing > Meters > créer un price dessus).
# Ajouté automatiquement au checkout du plan mensuel.
STRIPE_PRICE_ID_AGENT_RUN="price_..."

# Agent IA — multi-provider (au moins une des deux clés est requise)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
DEFAULT_AI_PROVIDER="claude"

# Resend (emails transactionnels)
RESEND_API_KEY="re_..."
EMAIL_FROM="SwiftSaaS <no-reply@votredomaine.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SwiftSaaS"
